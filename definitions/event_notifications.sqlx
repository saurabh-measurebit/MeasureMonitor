config {
  type: "assertion",
  description: "Raises an error if any event anomalies exist (alerts present)",
  dependencies: ["event_check_anomalies","event_monitoring_logs"],
  tags: ["event_monitoring", "notifications"]
}

-- This assertion will fail if any rows (alerts) exist in event_anomalies
-- But now it will provide detailed information about the anomalies
WITH anomalies AS (
  SELECT
    event_name,
    event_count,
    event_date,
    avg_count,
    lower_threshold,
    alert_message
  FROM
    ${ref("event_check_anomalies")}
  WHERE
    is_anomaly = TRUE
)

-- If anomalies exist, this will fail with a detailed error message
SELECT
  CONCAT(
    'Found ', CAST(COUNT(*) AS STRING), ' event anomalies:\n',
    STRING_AGG(alert_message, '\n')
  ) AS error_message
FROM
  anomalies
