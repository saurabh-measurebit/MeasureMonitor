config {
  type: "table",
  description: "Detects anomalies in event counts based on historical data",
  dependencies: ["event_counts", "historical_event_counts"],
  tags: ["event_monitoring", "anomaly_detection"],
  schema: "dataform"
}

-- Get current event counts
WITH current_counts AS (
  SELECT * FROM ${ref("event_counts")}
),

-- Get historical data for the past 7 days and calculate average/standard deviation
historical_data AS (
  SELECT
    event_name,
    AVG(event_count) as avg_count,
    STDDEV_SAMP(event_count) as stddev_count,
    COUNT(*) as data_points
  FROM ${ref("historical_event_counts")}
  WHERE
    -- Use data from the past 7 days, excluding today (which is in current_counts)
    event_date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
    AND event_name IN (${dataform.projectConfig.vars.events_list.split('#').map(e => `'${e}'`).join(', ')})
  GROUP BY
    event_name
),

-- Apply event-specific thresholds and handle null standard deviations
event_thresholds AS (
  SELECT
    event_name,
    CASE
      WHEN event_name = 'purchase' THEN ${dataform.projectConfig.vars.purchase_threshold_percentage}
      ELSE ${dataform.projectConfig.vars.threshold_percentage}
    END as threshold_percentage,
    CASE
      WHEN event_name = 'purchase' THEN ${dataform.projectConfig.vars.purchase_std_dev_multiplier}
      ELSE ${dataform.projectConfig.vars.std_dev_multiplier}
    END as std_dev_multiplier,
    CASE
      WHEN event_name = 'purchase' THEN ${dataform.projectConfig.vars.purchase_min_average}
      ELSE ${dataform.projectConfig.vars.min_average}
    END as min_average,
    -- Handle null standard deviations by using a percentage of the average
    IFNULL(stddev_count, avg_count * 0.1) as adjusted_stddev
  FROM
    historical_data
)

-- Detect anomalies
SELECT
  c.event_name,
  c.event_count,
  c.event_date,
  h.avg_count,
  h.stddev_count,
  t.threshold_percentage,
  t.std_dev_multiplier,
  t.min_average,
  -- Calculate threshold values using adjusted standard deviation
  GREATEST(
    h.avg_count * (1 - t.threshold_percentage / 100),
    h.avg_count - (t.adjusted_stddev * t.std_dev_multiplier)
  ) as lower_threshold,
  -- Determine if there's an anomaly
  CASE
    WHEN h.avg_count < t.min_average THEN FALSE  -- Skip if average is too low
    WHEN c.event_count < GREATEST(
      h.avg_count * (1 - t.threshold_percentage / 100),
      h.avg_count - (t.adjusted_stddev * t.std_dev_multiplier)
    ) THEN TRUE
    ELSE FALSE
  END as is_anomaly,
  -- Create alert message
  CASE
    WHEN h.avg_count < t.min_average THEN NULL  -- No alert if average is too low
    WHEN c.event_count < GREATEST(
      h.avg_count * (1 - t.threshold_percentage / 100),
      h.avg_count - (t.adjusted_stddev * t.std_dev_multiplier)
    ) THEN CONCAT(
      'ALERT: ', c.event_name, ' count (', CAST(c.event_count AS STRING),
      ') is below threshold (',
      CAST(GREATEST(
        h.avg_count * (1 - t.threshold_percentage / 100),
        h.avg_count - (t.adjusted_stddev * t.std_dev_multiplier)
      ) AS STRING),
      '). Average is ', CAST(h.avg_count AS STRING)
    )
    ELSE NULL
  END as alert_message,
  CURRENT_TIMESTAMP() as detection_time
FROM
  current_counts c
JOIN
  historical_data h ON c.event_name = h.event_name
JOIN
  event_thresholds t ON c.event_name = t.event_name
